# Copy to .env for local development. Never commit .env.
#
# Production does not read this file. Secrets there are injected by the
# deployment environment (Chapter 6) — a committed .env is the failure this
# separation exists to prevent.

# --- required ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- optional: defaults in app/config.py are correct for local work ----
# MODEL_ID=claude-sonnet-5
# MAX_TOKENS=4096
# APP_ENV=local

# Deliberately not settable: TEMPERATURE, TOP_P, TOP_K.
# Current Claude models reject non-default sampling parameters (ADR-000).

# --- V6 onward (Chapter 10): retrieval ---------------------------------
# DATABASE_URL=postgresql://widgetware:widgetware@localhost:5432/widgetware

# --- V10 (Chapter 14): observability -----------------------------------
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Content capture is off by default. Chapter 14 turns on a sanitized form
# deliberately rather than recording prompts and documents silently.
# CAPTURE_CONTENT=off
