# Google Cloud Vertex AI authentication
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=replace_with_your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Shared application settings
# MODEL selects the Gemini model every agent uses. It is optional: the
# application falls back to gemini-2.5-flash when it is unset. Override it for a
# single run without editing this file, for example:
#   MODEL=gemini-2.5-pro ./class-02C-work/start_web_server.sh
MODEL=gemini-2.5-flash
